import numpy as np
import pandas as pd

def generate_synthetic_evidence(duration=15.0, hop_time=0.016):
    """Generates synthetic time-indexed watermark evidence with a dip."""
    times = np.arange(0, duration, hop_time)
    scores = []
    valid_flags = []

    for t in times:
        if 5.0 <= t <= 8.0:
            score = np.random.normal(0.1, 0.05)
        else:
            score = np.random.normal(0.9, 0.03)

        score = np.clip(score, -1.0, 1.0)
        scores.append(score)
        valid_flags.append('yes')

    df = pd.DataFrame({
        'time_seconds': times,
        'watermark_score': scores,
        'valid_flag': valid_flags
    })
    return df

def sliding_window_analysis(df, window_size=0.5, overlap=0.5):
    step = window_size * (1 - overlap)
    start_time = df['time_seconds'].min()
    end_time = df['time_seconds'].max()

    results = []
    current_start = start_time

    while current_start + window_size <= end_time:
        current_end = current_start + window_size
        window_mask = (df['time_seconds'] >= current_start) & (df['time_seconds'] < current_end)
        window_data = df[window_mask]

        valid_frames = window_data[window_data['valid_flag'] == 'yes']
        if len(valid_frames) >= len(window_data) * 0.5:
            mean_score = valid_frames['watermark_score'].mean()
            status = 'determined'
        else:
            mean_score = None
            status = 'undetermined'

        results.append({
            'window_start': current_start,
            'window_end': current_end,
            'score': mean_score,
            'status': status
        })
        current_start += step

    return pd.DataFrame(results)

# --- ADD THESE LINES TO SEE OUTPUT ---
synthetic_data = generate_synthetic_evidence()
window_results = sliding_window_analysis(synthetic_data)

# Print the first few rows of the sliding window scores
print("Window Results Preview:")
print(window_results.head(15))

# Print windows where the score drops below 0.5 (detected tampered regions)
suspicious = window_results[window_results['score'] < 0.5]
print("\nSuspicious Windows Found:")
print(suspicious[['window_start', 'window_end', 'score']])
